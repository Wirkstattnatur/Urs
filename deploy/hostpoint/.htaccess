Options -Indexes
DirectoryIndex index.php index.html
DirectorySlash Off

RewriteEngine On

# Hostpoint terminates TLS before Apache and exposes the original port here.
RewriteCond %{SERVER_PORT} !=443
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Keep the staging host out of search results while retaining production canonicals.
RewriteCond %{HTTP_HOST} ^staging\.wirkstattnatur\.ch$ [NC]
RewriteRule ^robots\.txt$ /robots-staging.txt [L]

# Canonical production host once the main website is moved back to Hostpoint.
RewriteCond %{HTTP_HOST} ^www\.wirkstattnatur\.ch$ [NC]
RewriteRule ^ https://wirkstattnatur.ch%{REQUEST_URI} [R=301,L,NE]

# Canonical entry points. Internal ErrorDocument and DirectoryIndex
# subrequests keep the original THE_REQUEST, so these rules only affect
# requests made directly against the aliased URL.
RewriteCond %{THE_REQUEST} \s/index\.php/?[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/index(?:\.html)?/?[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/en/index(?:\.html)?/?[\s?] [NC]
RewriteRule ^ /en [R=301,L]

RewriteCond %{THE_REQUEST} \s/en\.html/?[\s?] [NC]
RewriteRule ^ /en [R=301,L]

# The error document must not be available as a standalone 200 page.
RewriteCond %{THE_REQUEST} \s/404(?:/|\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# The offer overview lives on the homepage, not on a directory index.
RewriteRule ^angebot/?$ /#angebot [R=301,L,NE]
RewriteRule ^en/angebot/?$ /en#angebot [R=301,L,NE]

# Redirects retained from the previous WordPress website.
RewriteRule ^wirkstattnatur-urs-gremlich-2(?:/.*)?$ / [R=301,L]
RewriteRule ^angebote/?$ /#angebot [R=301,L,NE]
RewriteRule ^gallery/?$ /#angebot [R=301,L,NE]
RewriteRule ^impressionen/?$ /#angebot [R=301,L,NE]
RewriteRule ^aktuell(?:es)?-thalwil/?$ / [R=301,L]
RewriteRule ^aktuelles/?$ / [R=301,L]
RewriteRule ^bewegung/?$ /#konzept [R=301,L,NE]
RewriteRule ^entspannung/?$ /#konzept [R=301,L,NE]
RewriteRule ^gesundheit/?$ /#konzept [R=301,L,NE]
RewriteRule ^eisenhorn-4/?$ /ueber-mich [R=301,L]
RewriteRule ^eisenhorn-thalwil-horgen(?:/.*)?$ /ueber-mich [R=301,L]
RewriteRule ^urs-gremlich-horgen/?$ /ueber-mich [R=301,L]
RewriteRule ^urs-gremlich-thalwil-horgen(?:/.*)?$ /ueber-mich [R=301,L]
RewriteRule ^werdegang/?$ /ueber-mich [R=301,L]
RewriteRule ^arbeitsweise/?$ /ueber-mich [R=301,L]
RewriteRule ^bgb/?$ /ueber-mich [R=301,L]
RewriteRule ^uber-mich/?$ /ueber-mich [R=301,L]
RewriteRule ^kontakt(?:-2|-3|fomular|formular)?/?$ /#kontakt [R=301,L,NE]
RewriteRule ^newsletter/?$ /#kontakt [R=301,L,NE]
RewriteRule ^preise-agb(?:-2)?(?:/.*)?$ /agb [R=301,L]
RewriteRule ^preise-und-agb/?$ /agb [R=301,L]
RewriteRule ^impressum-2/?$ /impressum [R=301,L]
RewriteRule ^sitemap(?:\.html|\.rss|_index\.xml)?/?$ /sitemap.xml [R=301,L]
RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^feed/?$ / [R=301,L]
RewriteRule ^comments/feed/?$ / [R=301,L]
RewriteRule ^wordpress/?$ / [R=301,L]
RewriteRule ^wp-admin(?:/.*)?$ / [R=301,L]
RewriteRule ^wp-login\.php$ / [R=301,L]

# Service pages and their old child, gallery and method URLs.
RewriteRule ^personal-?training.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^indoor-thalwil-horgen.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^outdoor-thalwil-horgen.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^hometraining(?:-eisenhorn)?-thalwil.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^massage-thalwil-horgen.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^wirkraum-massage-thalwil-horgen.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^wirkraum-thalwil/?$ /angebot/personal-training [R=301,L]
RewriteRule ^kraftraumberatung/?$ /angebot/personal-training [R=301,L]
RewriteRule ^marathon-triathlon-thalwil/?$ /angebot/personal-training [R=301,L]
RewriteRule ^nordic-walking/?$ /angebot/personal-training [R=301,L]
RewriteRule ^sling-training/?$ /angebot/personal-training [R=301,L]
RewriteRule ^wirbelsaeulentherapie.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^wirbelsaulentherapie.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^golf-?fitness.*$ /angebot/golf-fitness [R=301,L,NC]
RewriteRule ^pilates.*$ /angebot/pilates [R=301,L,NC]
RewriteRule ^karate.*$ /angebot/karate [R=301,L,NC]
RewriteRule ^kampfkunst/?$ /angebot/karate [R=301,L]
RewriteRule ^flagallery/karate.*$ /angebot/karate [R=301,L,NC]
RewriteRule ^flagallery/nordic-walking.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^flagallery/sling-training.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^flagallery/.*$ /#angebot [R=301,L,NE]
RewriteRule ^blog/golf-fitness.*$ /angebot/golf-fitness [R=301,L,NC]
RewriteRule ^blog/category/golf-fitness.*$ /angebot/golf-fitness [R=301,L,NC]
RewriteRule ^blog/personal-training.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^blog/category/personal-training.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^blog/pilates.*$ /angebot/pilates [R=301,L,NC]
RewriteRule ^blog/category/pilates.*$ /angebot/pilates [R=301,L,NC]
RewriteRule ^blog/wirbelsaeulentherapie.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^blog/category/wirbelsaeulentherapie.*$ /angebot/personal-training [R=301,L,NC]
RewriteRule ^blog/.*$ /#angebot [R=301,L,NE]

# English shortcuts for the canonical offer pages.
RewriteRule ^en/personal-?training.*$ /en/angebot/personal-training [R=301,L,NC]
RewriteRule ^en/golf-?fitness.*$ /en/angebot/golf-fitness [R=301,L,NC]
RewriteRule ^en/pilates.*$ /en/angebot/pilates [R=301,L,NC]
RewriteRule ^en/karate.*$ /en/angebot/karate [R=301,L,NC]
RewriteRule ^en/about.*$ /en/ueber-mich [R=301,L,NC]
RewriteRule ^en/services/?$ /en#angebot [R=301,L,NE,NC]
RewriteRule ^en/contact/?$ /en#kontakt [R=301,L,NE,NC]

# Old WordPress uploads and attachment pages.
RewriteRule ^wp-content/uploads/.*Fotografie-Manufaktur-168.*$ /ueber-mich [R=301,L,NC]
RewriteRule ^wp-content/uploads/.*Fotografie-Manufaktur-158.*$ /favicon.ico [R=301,L,NC]
RewriteRule ^wp-content/uploads/.*Gesundheitsfragebogen\.pdf$ /agb [R=301,L,NC]
RewriteRule ^wp-content/uploads/.*$ /#angebot [R=301,L,NE]
RewriteRule ^(?:cropped-.*168|fotografie-manufaktur-168).*$ /ueber-mich [R=301,L,NC]
RewriteRule ^(?:cropped|fotografie|forest|img_|img-|unknown-5|gruener-hintergrund).*$ /#angebot [R=301,L,NE]

# Serve prerendered .html files at their canonical extensionless URLs.
RewriteRule ^(.+)/$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [END]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "base-uri 'self'; frame-ancestors 'self'; object-src 'none'"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" "expr=%{HTTP_HOST} == 'staging.wirkstattnatur.ch'"

  Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset
</IfModule>

SetEnvIf Request_URI "^/assets/" immutable_asset

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
